{
  "name": "gan-deng-yan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "scripts": {
    "dev": "concurrently -k -n game,web 'npm:dev:server' 'npm:dev:web'",
    "dev:server": "node --import tsx --watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
